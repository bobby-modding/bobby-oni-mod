<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>

    <RootNamespace>MaterialSearchOverlay</RootNamespace>
    <AssemblyName>MaterialSearchOverlay</AssemblyName>

    <Version>1.3.0</Version>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>

    <MinimumSupportedBuild>722606</MinimumSupportedBuild>
    <ModAPIVersion>2</ModAPIVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="PLib" Version="4.25.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="ILRepack.Lib.MSBuild.Task" Version="2.0.40">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="0Harmony">
      <HintPath>$(GameLibsFolder)/0Harmony.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Newtonsoft.Json">
      <HintPath>$(GameLibsFolder)/Newtonsoft.Json.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameLibsFolder)/Assembly-CSharp.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameLibsFolder)/Assembly-CSharp-firstpass.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(GameLibsFolder)/UnityEngine.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameLibsFolder)/UnityEngine.CoreModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.UI">
      <HintPath>$(GameLibsFolder)/UnityEngine.UI.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="Unity.TextMeshPro">
      <HintPath>$(GameLibsFolder)/Unity.TextMeshPro.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Reference Include="UnityEngine.TextRenderingModule">
      <HintPath>$(GameLibsFolder)/UnityEngine.TextRenderingModule.dll</HintPath>
      <Private>False</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      The overlay icon is embedded rather than deployed as a loose file so the mod never has
      to locate its own folder at runtime. Include, not Update: the SDK's default png glob
      skips files that are already listed, so this is the only copy, and a missing icon then
      fails the build (CS1566) instead of quietly shipping without one. The LogicalName
      overrides the default of RootNamespace + path (MaterialSearchOverlay...), which is not
      the code namespace Patches refers to it by.
    -->
    <EmbeddedResource Include="icons/overlay_material_search.png"
      LogicalName="BobbyModding.MaterialSearchOverlay.overlay_material_search.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="mod.yaml" CopyToOutputDirectory="Always" />
    <None Update="mod_info.yaml" CopyToOutputDirectory="Always" />
    <None Update="translations/*.po" CopyToOutputDirectory="Always" />
  </ItemGroup>

  <Target Name="GenerateModInfoYaml" BeforeTargets="BeforeBuild">
    <WriteLinesToFile File="$(MSBuildProjectDirectory)/mod_info.yaml" Overwrite="true"
      Lines="supportedContent: ALL;minimumSupportedBuild: $(MinimumSupportedBuild);version: $(Version);APIVersion: $(ModAPIVersion)" />
    <Message Text="Generated mod_info.yaml (version $(Version))" Importance="high" />
  </Target>

  <!--
    Archive + deploy live in the shared root targets file so every mod project (and the
    template new mods are generated from) behaves the same: the build is archived per game
    build, then that archive is what gets deployed to the local Dev mods folder.
  -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('OniModDeploy.targets', '$(MSBuildThisFileDirectory)../'))" />

